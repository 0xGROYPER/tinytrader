{
  "name": "quickstart",
  "focus": "ticker",
  "hosts": [
    {
      "id": "local",
      "label": "local",
      "sub": "Docker Compose"
    }
  ],
  "external": [
    {
      "id": "coinbase",
      "label": "coinbase",
      "sub": "public ticker feed",
      "role": "Coinbase Exchange public websocket. No account or API key needed."
    }
  ],
  "services": [
    {
      "id": "ticker",
      "host": "local",
      "label": "ticker",
      "role": "Toy service: streams Coinbase tickers to JSON Lines files and reports health and metrics.",
      "health": "http://ticker:9100/health",
      "metrics": "http://ticker:9100/metrics",
      "recent": "http://ticker:9100/recent"
    },
    {
      "id": "docker-proxy",
      "host": "local",
      "label": "docker-proxy",
      "role": "Read-only view of the Docker API. The console reads container state through it and cannot change anything."
    },
    {
      "id": "console",
      "host": "local",
      "label": "console",
      "role": "This page. Polls every service and Docker every two seconds.",
      "health": "http://127.0.0.1:8080/health",
      "metrics": "http://127.0.0.1:8080/metrics"
    }
  ],
  "stores": [
    {
      "id": "ticker-data",
      "host": "local",
      "label": "ticker-data",
      "sub": "Docker volume",
      "role": "JSON Lines files, one per product and UTC day.",
      "metric": {
        "service": "ticker",
        "name": "glacier_ticker_bytes_written_total",
        "label": "Bytes written",
        "format": "bytes",
        "suffix": " written"
      }
    }
  ],
  "edges": [
    {
      "from": "coinbase",
      "to": "ticker",
      "kind": "flow",
      "label": "websocket"
    },
    {
      "from": "ticker",
      "to": "ticker-data",
      "kind": "flow",
      "label": "jsonl"
    },
    {
      "from": "ticker",
      "to": "console",
      "kind": "read",
      "label": "health \u00b7 metrics"
    },
    {
      "from": "docker-proxy",
      "to": "console",
      "kind": "read",
      "label": "container state"
    }
  ],
  "panels": [
    {
      "service": "ticker",
      "source": "recent",
      "heading": "Live data",
      "note": "Sampled once per second",
      "title": "{key}",
      "decimals": 2,
      "footer": [
        {
          "metric": "glacier_ticker_messages_total",
          "match": "product",
          "format": "count",
          "suffix": " messages"
        },
        {
          "metric": "glacier_ticker_last_message_age_seconds",
          "match": "product",
          "format": "age",
          "prefix": "last ",
          "suffix": " ago"
        }
      ]
    }
  ]
}
